      # ============================================================

      - name: Commit Small Analysis Results
        run: |

          set -e

          echo "=========================================="
          echo "COMMIT SMALL ANALYSIS RESULTS"
          echo "=========================================="

          git config user.name \
            "github-actions[bot]"

          git config user.email \
            "41898282+github-actions[bot]@users.noreply.github.com"

